{
	# Global options
	# storage จะ persist Caddy's local CA root + auto-generated certs
	# (mounted ที่ /data ใน container)
	auto_https disable_redirects
}

# ════════════════════════════════════════════════════════════════════
# HTTPS site — IP-based (self-signed via Caddy local CA)
# ════════════════════════════════════════════════════════════════════
#
# Browser warning ครั้งแรก: "Connection not private" → คลิก Advanced → Proceed
# วิธีกำจัด warning: import Caddy root CA จากไฟล์
#   container:  /data/caddy/pki/authorities/local/root.crt
#   host path:  ./volumes/caddy-data/caddy/pki/authorities/local/root.crt
#
# Upgrade to Let's Encrypt:
#   1. ซื้อ domain (เช่น smartpole.your-domain.com)
#   2. ตั้ง DNS A record → IP server
#   3. แก้บรรทัด site address ด้านล่าง: เปลี่ยน "152.42.242.162:443" → "smartpole.your-domain.com"
#   4. ลบบรรทัด "tls internal"
#   5. docker compose restart caddy
#   → Caddy จะ ACME challenge ผ่าน port 80 อัตโนมัติ + ออก cert จาก Let's Encrypt
# ════════════════════════════════════════════════════════════════════

152.42.242.162:443 {
	tls internal

	# ── Backend WebSocket (sensor live + invalidations) ─────
	# เปิดก่อน /api/* เพื่อให้ matcher จับ upgrade header
	@websocket {
		path /ws*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket backend:7766

	# ── Backend REST API ───────────────────────────────────
	handle /api/* {
		reverse_proxy backend:7766 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# ── HLS live streaming (SRS) ───────────────────────────
	# Browser ดู /hls/live/<pole>.m3u8 → SRS port 8080
	handle /hls/* {
		uri strip_prefix /hls
		reverse_proxy srs:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# ── Frontend (Next.js — catch-all) ─────────────────────
	handle {
		reverse_proxy frontend:7765 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# ── Security headers ───────────────────────────────────
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# CSP เปิดทีหลัง — ตอนนี้ Next.js dev มี inline script
	}

	# ── Logging ────────────────────────────────────────────
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# ════════════════════════════════════════════════════════════════════
# HTTP → HTTPS redirect (port 80)
# ════════════════════════════════════════════════════════════════════
http://152.42.242.162 {
	redir https://{host}{uri} permanent
}
