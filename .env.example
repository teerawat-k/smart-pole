# ── Project (root .env — ใช้กับ docker-compose) ──
NODE_ENV=development
DOCKERHUB_USERNAME=teerawatk
IMAGE_TAG=latest

# ── Database (Postgres local install — ไม่อยู่ใน compose) ──
# ติดตั้ง Postgres 17/18 + TimescaleDB extension บน host
# CREATE EXTENSION IF NOT EXISTS timescaledb;
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/smart_pole

# ── MQTT (Mosquitto) ──
MQTT_TCP_PORT=7783
MQTT_WS_PORT=7791
MQTT_USERNAME=backend-subscriber
MQTT_PASSWORD=

# ── SRS streaming ──
SRS_RTMP_PORT=7735
SRS_HLS_PORT=7780
SRS_API_PORT=7785
SRS_DVR_TOKEN=replace-with-shared-secret

# ── Backend ──
BACKEND_PORT=7766
JWT_SECRET=replace-with-random-256-bit-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Frontend ──
FRONTEND_PORT=7765
NEXT_PUBLIC_API_URL=http://localhost:7766
NEXT_PUBLIC_WS_URL=ws://localhost:7766/ws
NEXT_PUBLIC_HLS_BASE=http://localhost:7780
NEXT_PUBLIC_PROJECT_PREFIX=smart-pole
