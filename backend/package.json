{
  "name": "backend",
  "type": "module",
  "scripts": {
    "kill-port": "bun scripts/kill-port.ts",
    "dev": "bun run setup && bun run kill-port && bun --watch src/index.ts",
    "start": "bun run setup && bun src/index.ts",
    "db:migrate": "bunx prisma migrate dev --config prisma/prisma.config.ts",
    "db:deploy": "bunx prisma migrate deploy --config prisma/prisma.config.ts",
    "db:seed": "bun prisma/seeds/index.ts",
    "db:studio": "bunx prisma studio",
    "db:generate": "bunx prisma generate --config prisma/prisma.config.ts",
    "lint": "bunx eslint src/",
    "test": "bun run test:unit",
    "test:unit": "bun run scripts/run-unit-tests.ts",
    "test:integration": "bun run scripts/run-integration-tests.ts",
    "test:all": "bun test",
    "test:watch": "bun test --watch",
    "setup": "mkdir -p data/uploads data/recordings"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "argon2": "^0.44.0",
    "elysia": "^1.4.27",
    "mqtt": "^5.15.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.18.0",
    "aedes": "^1.0.2",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.5.0",
    "typescript": "^5.9.3"
  }
}
