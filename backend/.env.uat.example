# ── Smart Pole Backend — UAT environment template ──
# Copy เป็น .env.uat บนเครื่อง deploy + กรอกค่าจริง — ห้าม commit ค่าจริง

# App
NODE_ENV=staging
PORT=7766

# Database
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/smart_pole_uat

# Auth (random ≥ 32 chars per environment)
JWT_SECRET=__REPLACE_WITH_UAT_RANDOM_256_BIT__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — ใส่ origin ของ frontend UAT
CORS_ORIGIN=https://uat.smart-pole.example.com

# Storage paths (volume mount จาก compose)
# Camera clips: $UPLOAD_DIR/camera/<poleName>/<YYYY-MM-DD>/<file>.mp4
UPLOAD_DIR=data/uploads

# MQTT
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=backend-subscriber
MQTT_PASSWORD=__REPLACE__
MQTT_CLIENT_ID=smart-pole-backend-uat
MQTT_TIMESTAMP_DRIFT_MAX_SEC=300

# Pole offline detection (นาที)
POLE_OFFLINE_THRESHOLD_MINUTES=5

# Logging
LOG_LEVEL=info
