# ── Smart Pole Backend — PRODUCTION environment template ──
# Copy เป็น .env.production บน production host — ห้าม commit ค่าจริง
# ใช้ secret manager (Vault, AWS Secrets Manager) ในระบบจริง

# App
NODE_ENV=production
PORT=7766

# Database (production cluster — ห้ามใช้ตัวเดียวกับ UAT)
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/smart_pole_prod

# Auth (random ≥ 32 chars — ห้ามซ้ำ UAT)
JWT_SECRET=__REPLACE_WITH_PROD_RANDOM_256_BIT__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — production domain เท่านั้น
CORS_ORIGIN=https://smart-pole.example.com

# Storage paths
UPLOAD_DIR=data/uploads
RECORDINGS_DIR=data/recordings

# MQTT — production ต้องใช้ TLS (mqtts://, port 8883)
MQTT_BROKER_URL=mqtts://mosquitto:8883
MQTT_USERNAME=backend-subscriber-prod
MQTT_PASSWORD=__REPLACE__
MQTT_CLIENT_ID=smart-pole-backend-prod
MQTT_TIMESTAMP_DRIFT_MAX_SEC=300

# SRS streaming (production = TLS หรือ behind reverse proxy)
SRS_HLS_BASE=https://stream.smart-pole.example.com
SRS_DVR_TOKEN=__REPLACE_WITH_SHARED_SECRET__

# Pole offline detection
POLE_OFFLINE_THRESHOLD_MINUTES=5

# Logging — production ใช้ warn ขึ้น
LOG_LEVEL=warn
