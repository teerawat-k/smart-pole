// Smart Pole — Prisma schema
// ทุก master model ต้องมี audit + soft-delete fields ตาม convention (ดู backend/CLAUDE.md § "Model Convention")
// ห้ามมี `isActive` field — ใช้ soft delete (`deletedAt`) อย่างเดียว
// ใช้ status enum เฉพาะกิจถ้าต้อง "ปิดใช้งานชั่วคราว"
//
// Database: PostgreSQL 18 (smart_pole) บน localhost:5432
// TimescaleDB extension: ติดตั้งทีหลัง — sensor table (E08) จะใช้ Postgres ปกติก่อน

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url ถูกกำหนดผ่าน PrismaPg adapter ใน prisma.config.ts
}

// ── Audit Log ────────────────────────────────────────────────────────────
// ทุก mutation ใน service เรียก auditService.log() แบบ fire-and-forget
// ห้าม await — fail ตรงนี้ไม่ block business flow
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | REORDER | UPDATE_<FIELD> | ...
  module    String   // pole | user | role | sensor | ...
  targetId  Int
  payload   Json?    // before/after diff หรือ extra context
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
