// Smart Pole — Prisma schema
// ทุก model ต้องมี audit + soft-delete fields ตาม convention (ดู backend/CLAUDE.md § "Model Convention")

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

