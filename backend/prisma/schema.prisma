// Smart Pole — Prisma schema
// ทุก master model ต้องมี audit + soft-delete fields ตาม convention (ดู backend/CLAUDE.md § "Model Convention")
// ห้ามมี `isActive` field — ใช้ soft delete (`deletedAt`) อย่างเดียว
// "ปิดใช้งานชั่วคราว" → ใช้ status enum เฉพาะกิจ
//
// Database: PostgreSQL 18 (smart_pole) บน localhost:5432
// TimescaleDB extension: ติดตั้งทีหลัง — sensor table (E08) จะใช้ Postgres ปกติก่อน

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url ถูกกำหนดผ่าน PrismaPg adapter ใน prisma.config.ts
}

// ─── Audit Log ────────────────────────────────────────────────────────────
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  targetId  Int
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Permission (master) ──────────────────────────────────────────────────
model Permission {
  id                Int      @id @default(autoincrement())
  module            String
  action            String
  category          String
  categoryLabel     String
  moduleLabel       String
  actionLabel       String
  actionDescription String?
  createdAt         DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

// ─── Role ─────────────────────────────────────────────────────────────────
model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Int
  updatedBy   Int?
  deletedAt   DateTime?
  deletedBy   Int?

  permissions RolePermission[]
  users       User[]

  @@index([deletedAt])
  @@map("roles")
}

// ─── Role × Permission ────────────────────────────────────────────────────
model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── User ─────────────────────────────────────────────────────────────────
enum UserStatus {
  active
  disabled
  locked
}

model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  email     String  @unique
  password  String
  firstName String
  lastName  String
  mobileNo  String?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  status UserStatus @default(active)

  loginFailCount Int       @default(0)
  lockedUntil    DateTime?
  lockedReason   String?

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  tokenVersion      Int       @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int
  updatedBy Int?
  deletedAt DateTime?
  deletedBy Int?

  refreshTokens RefreshToken[]

  @@index([deletedAt])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

// ─── Refresh Token ────────────────────────────────────────────────────────
model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  tokenHash    String    @unique
  family       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Captcha Attempt ──────────────────────────────────────────────────────
model CaptchaAttempt {
  id          Int      @id @default(autoincrement())
  sessionKey  String   @unique
  captchaHash String
  isSolved    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("captcha_attempts")
}

// ─── System Log ───────────────────────────────────────────────────────────
enum SystemLogType {
  login_success
  login_fail
  logout
  captcha_fail
  page_access
}

model SystemLog {
  id           BigInt        @id @default(autoincrement())
  logType      SystemLogType
  userId       Int?
  usernameSnap String?
  failReason   String?
  pageKey      String?
  ipAddress    String?
  userAgent    String?
  detail       Json?
  createdAt    DateTime      @default(now())

  @@index([logType])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}

// ─── Pole (เสาสัญญาณ) ───────────────────────────────────────────────────
enum PoleStatus {
  online
  offline
  unknown
  maintenance
}

model Pole {
  id            Int        @id @default(autoincrement())
  poleName      String     @unique // ใช้เป็น MQTT topic + RTMP stream key
  installPlace  String
  ddnsHostname  String?    @unique
  ipCamera      String?
  cameraModel   String?    @default("Dahua IPC-HFW5442E-ZE")

  // Geolocation (lat -90..90, lng -180..180 — validate ใน schema layer)
  latitude      Decimal?   @db.Decimal(10, 7)
  longitude     Decimal?   @db.Decimal(10, 7)

  // Capability flags
  hasCamera        Boolean @default(false)
  hasPm25Sensor    Boolean @default(false)
  hasTempHumidity  Boolean @default(false)
  hasLed           Boolean @default(false)

  // Status
  poleStatus    PoleStatus @default(unknown)
  lastSeenAt    DateTime?
  maintenanceReason String?

  // MQTT credential (per pole, generated by backend)
  mqttUsername     String  @unique
  mqttPasswordHash String

  // Standard audit + soft delete (no isActive)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int
  updatedBy Int?
  deletedAt DateTime?
  deletedBy Int?

  @@index([poleStatus, lastSeenAt])
  @@index([deletedAt])
  @@map("poles")
}

// ─── Sensor Type Master ────────────────────────────────────────────────────
// ลงทะเบียน sensor type ที่ระบบรู้จัก — เพิ่ม sensor ใหม่ผ่าน seed
model SensorType {
  id            Int      @id @default(autoincrement())
  key           String   @unique // "pm25", "temperature", "humidity", "heartbeat_signal"
  displayName   String
  unit          String?
  tableName     String // "sensor_pm25"
  chartType     String? // "line" | "bar" | "gauge"
  chartColor    String?
  retentionDays Int      @default(365)
  isEnabled     Boolean  @default(true)
  // standard audit + soft delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     Int
  updatedBy     Int?
  deletedAt     DateTime?
  deletedBy     Int?

  @@map("sensor_types")
}

// ─── Sensor: PM2.5 ─────────────────────────────────────────────────────────
// 1 sensor type = 1 table — schema เฉพาะ (PM2.5 + PM10 + AQI)
model SensorPm25 {
  time       DateTime
  poleId     Int
  seq        BigInt
  pm25       Float
  pm10       Float?
  aqi        Int?
  rawJson    Json?
  ingestedAt DateTime @default(now())

  @@id([time, poleId])
  @@index([poleId, time(sort: Desc)])
  @@map("sensor_pm25")
}

// ─── Sensor: Temperature ───────────────────────────────────────────────────
model SensorTemperature {
  time        DateTime
  poleId      Int
  seq         BigInt
  temperature Float // celsius (normalize ก่อน save)
  unit        String   @default("celsius") // "celsius" | "fahrenheit" (raw payload)
  rawJson     Json?
  ingestedAt  DateTime @default(now())

  @@id([time, poleId])
  @@index([poleId, time(sort: Desc)])
  @@map("sensor_temperature")
}

// ─── Sensor: Humidity ──────────────────────────────────────────────────────
model SensorHumidity {
  time       DateTime
  poleId     Int
  seq        BigInt
  humidity   Float // %RH (0..100)
  rawJson    Json?
  ingestedAt DateTime @default(now())

  @@id([time, poleId])
  @@index([poleId, time(sort: Desc)])
  @@map("sensor_humidity")
}

// ─── Sensor: Heartbeat Signal ──────────────────────────────────────────────
model SensorHeartbeatSignal {
  time           DateTime
  poleId         Int
  signalDbm      Int? // -120..0
  uptimeSec      BigInt?
  firmwareVersion String?
  ingestedAt     DateTime @default(now())

  @@id([time, poleId])
  @@index([poleId, time(sort: Desc)])
  @@map("sensor_heartbeat_signal")
}

// ─── System Config (key-value, runtime tunable) ────────────────────────────
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@map("system_configs")
}

// ─── Alert ─────────────────────────────────────────────────────────────────
enum AlertSeverity {
  info
  warning
  critical
}

model Alert {
  id           Int            @id @default(autoincrement())
  poleId       Int
  alertType    String
  severity     AlertSeverity  @default(warning)
  message      String
  value        Decimal?       @db.Decimal(12, 4)
  threshold    Decimal?       @db.Decimal(12, 4)

  isResolved   Boolean        @default(false)
  resolvedAt   DateTime?
  resolvedById Int?
  resolvedNote String?

  triggeredAt  DateTime       @default(now())
  createdAt    DateTime       @default(now())

  @@index([poleId, isResolved, triggeredAt(sort: Desc)])
  @@index([severity])
  @@index([alertType])
  @@map("alerts")
}

// ─── VideoRecording (camera DVR index) ─────────────────────────────────────
model VideoRecording {
  id            BigInt   @id @default(autoincrement())
  poleId        Int
  filename      String   @unique
  storagePath   String
  recordedDate  DateTime @db.Date
  startTime     DateTime
  endTime       DateTime
  durationSec   Int
  fileSizeBytes BigInt?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int       @default(0)
  updatedBy Int?
  deletedAt DateTime?
  deletedBy Int?

  @@index([poleId, recordedDate(sort: Desc)])
  @@index([deletedAt])
  @@map("video_recordings")
}

// ─── Sensor: Unknown (debug) ───────────────────────────────────────────────
model SensorUnknown {
  id        BigInt   @id @default(autoincrement())
  time      DateTime
  poleId    Int
  sensorKey String
  rawJson   Json
  reason    String // "no_handler" | "validation_failed"
  ingestedAt DateTime @default(now())

  @@index([sensorKey, time(sort: Desc)])
  @@index([poleId, time(sort: Desc)])
  @@map("sensor_unknown")
}
