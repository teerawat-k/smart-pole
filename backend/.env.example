# ── App ──
NODE_ENV=development
PORT=7766

# ── Database (Postgres + TimescaleDB local install) ──
# Copy เป็น .env แล้วแทน <YOUR_LOCAL_POSTGRES_PASSWORD> ด้วย password ของ Postgres dev บนเครื่อง
DATABASE_URL=postgresql://postgres:<YOUR_LOCAL_POSTGRES_PASSWORD>@localhost:5432/smart_pole

# ── Auth ──
JWT_SECRET=replace-with-random-256-bit-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──
CORS_ORIGIN=http://localhost:7765

# ── Storage (local file system) ──
# Camera clips ที่ผู้ใช้ดูจะอยู่ที่: $UPLOAD_DIR/camera/<poleName>/<YYYY-MM-DD>/<file>.mp4
UPLOAD_DIR=data/uploads

# ── MQTT (Mosquitto) ──
# Default = host-mapped port 7783 (รัน `bun dev` ตรงบนเครื่อง — Mosquitto อยู่ใน Docker)
# ถ้า backend ขึ้น Docker compose `app` profile — override ใน docker-compose.yml เป็น mqtt://mosquitto:1883
MQTT_BROKER_URL=mqtt://localhost:7783
MQTT_USERNAME=backend-subscriber
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-pole-backend
MQTT_TIMESTAMP_DRIFT_MAX_SEC=300

# ── Pole offline detection ──
POLE_OFFLINE_THRESHOLD_MINUTES=5

# ── Logging ──
LOG_LEVEL=info
