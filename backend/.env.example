# ── App ──
NODE_ENV=development
PORT=7766

# ── Database (Postgres + TimescaleDB local install) ──
DATABASE_URL=postgresql://postgres:gg0943455931@localhost:5432/smart_pole

# ── Auth ──
JWT_SECRET=replace-with-random-256-bit-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──
CORS_ORIGIN=http://localhost:7765

# ── Storage (local file system) ──
UPLOAD_DIR=data/uploads
RECORDINGS_DIR=data/recordings

# ── MQTT (Mosquitto) ──
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=backend-subscriber
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-pole-backend
MQTT_TIMESTAMP_DRIFT_MAX_SEC=300

# ── SRS streaming ──
SRS_HLS_BASE=http://localhost:7780
SRS_DVR_TOKEN=replace-with-shared-secret

# ── Logging ──
LOG_LEVEL=info
